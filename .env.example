# Si es "true" corre el navegador del buscador de casas sin mostrar ventana.
# Si un día empieza a devolver 0 resultados de forma rara, prueba con
# "false" para ver qué está pasando (se abre una ventana de Chromium).
SCRAPER_HEADLESS=true

# Cuántas páginas de resultados revisar (cada página trae ~30 avisos).
MAX_PAGES=3
